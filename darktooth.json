{
  "workbench.colorCustomizations": {
    "editor.background": "#282828",
    "editor.foreground": "#FDF4C1",
    "editorCursor.foreground": "#FDF4C1",
    "editorWhitespace.foreground": "#504945",
    "editor.lineHighlightBackground": "#2B3C44",
    "editor.selectionBackground": "#1B5C6B",
    "editor.inactiveSelectionBackground": "#30434C"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comment",
        "scope": "comment",
        "settings": {
          "foreground": "#7C6F64",
          "fontStyle": "italic"
        }
      },
      {
        "name": "String",
        "scope": [
          "string",
          "punctuation.definition.template-expression"
        ],
        "settings": {
          "foreground": "#528B8B"
        }
      },
      {
        "name": "Number",
        "scope": [
          "constant.numeric",
          "keyword.other.unit"
        ],
        "settings": {
          "foreground": "#D3869B"
        }
      },
      {
        "name": "Built-in constant",
        "scope": [
          "constant.language",
          "support.variable.property.dom"
        ],
        "settings": {
          "foreground": "#BBAA97"
        }
      },
      {
        "name": "User-defined constant",
        "scope": [
          "constant.character",
          "constant.other"
        ],
        "settings": {
          "foreground": "#BBAA97"
        }
      },
      {
        "name": "Variable",
        "scope": "variable",
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Keyword",
        "scope": "keyword",
        "settings": {
          "foreground": "#DD6F48"
        }
      },
      {
        "name": "Storage",
        "scope": "storage",
        "settings": {
          "foreground": "#DD6F48"
        }
      },
      {
        "name": "Storage type",
        "scope": "storage.type",
        "settings": {
          "foreground": "#66999D"
        }
      },
      {
        "name": "Class name",
        "scope": [
          "entity.name.class",
          "entity.name.type.class"
        ],
        "settings": {
          "foreground": "#66999D",
          "fontStyle": "underline"
        }
      },
      {
        "name": "Inherited class",
        "scope": "entity.other.inherited-class",
        "settings": {
          "foreground": "#FDF4C1",
          "fontStyle": "italic underline"
        }
      },
      {
        "name": "Function name",
        "scope": "entity.name.function",
        "settings": {
          "foreground": "#A89984"
        }
      },
      {
        "name": "Function argument",
        "scope": "variable.parameter",
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Tag name",
        "scope": "entity.name.tag",
        "settings": {
          "foreground": "#A89984"
        }
      },
      {
        "name": "Tag attribute",
        "scope": "entity.other.attribute-name",
        "settings": {
          "foreground": "#83A598",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Library function",
        "scope": "support.function",
        "settings": {
          "foreground": "#FE8019"
        }
      },
      {
        "name": "Library constant",
        "scope": "support.constant",
        "settings": {
          "foreground": "#5FAFAF"
        }
      },
      {
        "name": "Library class/type",
        "scope": [
          "support.type",
          "support.class"
        ],
        "settings": {
          "foreground": "#FE8019"
        }
      },
      {
        "name": "Library variable",
        "scope": [
          "support.other.variable",
          "variable.other.property"
        ],
        "settings": {
          "foreground": "#FDF4C1"
        }
      },
      {
        "name": "Invalid",
        "scope": "invalid",
        "settings": {
          "foreground": "#FDF4C1",
          "background": "#FB4933"
        }
      },
      {
        "name": "Invalid deprecated",
        "scope": "invalid.deprecated",
        "settings": {
          "foreground": "#282828",
          "background": "#FABD2F"
        }
      },
      {
        "name": "Template string punctuation",
        "scope": [
          "constant.other.placeholder",
          "meta.template.expression"
        ],
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Special variables",
        "scope": "support.module",
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Entity",
        "scope": "entity.name.type",
        "settings": {
          "foreground": "#66999D"
        }
      },
      {
        "name": "Modules",
        "scope": "entity.name.module",
        "settings": {
          "foreground": "#FE8019"
        }
      },
      {
        "name": "Error",
        "scope": "message.error",
        "settings": {
          "foreground": "#FB4933"
        }
      },
      {
        "name": "Hyperlink",
        "scope": [
          "variable.parameter.url",
          "meta.function.url",
          "constant.other.reference.link",
          "string.other.link"
        ],
        "settings": {
          "foreground": "#528B8B",
          "fontStyle": "underline"
        }
      },
      {
        "name": "CSS: font name",
        "scope": "support.constant.font-name",
        "settings": {
          "foreground": "#66999D"
        }
      },
      {
        "name": "CSS: property name",
        "scope": "meta.property-name",
        "settings": {
          "foreground": "#FE8019"
        }
      },
      {
        "name": "CSS: property name vendor prefix",
        "scope": [
          "meta.property-name support.type.vendor-prefix",
          "support.type.property-name.media support.type.vendor-prefix"
        ],
        "settings": {
          "foreground": "#FE8019",
          "fontStyle": "italic"
        }
      },
      {
        "name": "CSS: property value",
        "scope": [
          "meta.property-value",
          "support.constant.property-value",
          "punctuation.terminator.rule"
        ],
        "settings": {
          "foreground": "#FDF4C1"
        }
      },
      {
        "name": "CSS: property value vendor prefix",
        "scope": "meta.property-value support.type.vendor-prefix",
        "settings": {
          "foreground": "#FDF4C1",
          "fontStyle": "italic"
        }
      },
      {
        "name": "GitGutter deleted",
        "scope": "markup.deleted.git_gutter",
        "settings": {
          "foreground": "#FB4934"
        }
      },
      {
        "name": "GitGutter inserted",
        "scope": "markup.inserted.git_gutter",
        "settings": {
          "foreground": "#B8BB26"
        }
      },
      {
        "name": "GitGutter changed",
        "scope": "markup.changed.git_gutter",
        "settings": {
          "foreground": "#EBDBB2"
        }
      },
      {
        "name": "GitGutter ignored",
        "scope": "markup.ignored.git_gutter",
        "settings": {
          "foreground": "#928374"
        }
      },
      {
        "name": "GitGutter untracked",
        "scope": "markup.untracked.git_gutter",
        "settings": {
          "foreground": "#928374"
        }
      },
      {
        "name": "Git modified line",
        "scope": "git.changes.x",
        "settings": {
          "foreground": "#83A598",
          "background": "#1B5C6B"
        }
      },
      {
        "name": "Git added line",
        "scope": "git.changes.+",
        "settings": {
          "foreground": "#B8BB26",
          "background": "#556C21"
        }
      },
      {
        "name": "Git removed line",
        "scope": "git.changes.-",
        "settings": {
          "foreground": "#FB4933",
          "background": "#901A1E"
        }
      },
      {
        "name": "Markdown: bold",
        "scope": "markup.bold.markdown",
        "settings": {
          "foreground": "#FE8019",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown: italic",
        "scope": "markup.italic.markdown",
        "settings": {
          "foreground": "#FE8019",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Markdown: link title",
        "scope": "string.other.link.title.markdown",
        "settings": {
          "foreground": "#528B8B"
        }
      },
      {
        "name": "Markdown: link",
        "scope": "markup.underline.link.markdown",
        "settings": {
          "foreground": "#FDF4C1",
          "fontStyle": "underline"
        }
      },
      {
        "name": "Markdown: separator",
        "scope": "meta.separator.markdown",
        "settings": {
          "foreground": "#928374"
        }
      },
      {
        "name": "Markdown: inline code",
        "scope": [
          "markup.inline.raw.string.markdown",
          "markup.raw.inline"
        ],
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Markdown: code block",
        "scope": "markup.fenced_code.block.markdown",
        "settings": {
          "foreground": "#83A598"
        }
      },
      {
        "name": "Markdown: unnumbered list",
        "scope": "markup.list.unnumbered.markdown",
        "settings": {
          "foreground": "#BBAA97"
        }
      },
      {
        "name": "Markdown: numbered list",
        "scope": "markup.list.numbered.markdown",
        "settings": {
          "foreground": "#D3869B"
        }
      },
      {
        "name": "Markdown: heading",
        "scope": [
          "markup.heading.markdown",
          "punctuation.definition.heading.markdown"
        ],
        "settings": {
          "foreground": "#66999D"
        }
      },
      {
        "name": "Python: generic function call",
        "scope": "meta.function-call.generic",
        "settings": {
          "foreground": "#A89984"
        }
      }
    ]
  }
}